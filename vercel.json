{
  "functions": {
    "api/index.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/onepiece.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/portfolio-history",
      "schedule": "30 10 * * *"
    }
  ]
}
